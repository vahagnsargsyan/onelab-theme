<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% comment %}
      Font preloading. Only the two faces likely to paint first — body and
      heading — and only their base weight; the rest load on demand through the
      @font-face rules in css-variables. Preloading more competes with the
      critical CSS for bandwidth.

      Heading is skipped when it shares a family with body, which is the default,
      so a default install preloads one file rather than two.
    {% endcomment %}
    {%- liquid
      assign body_font = settings.font_body
      assign heading_font = settings.font_heading

      assign preload_body = false
      unless body_font.system? or settings.font_body_custom != blank
        assign preload_body = true
      endunless

      assign preload_heading = false
      unless heading_font.system? or settings.font_heading_custom != blank
        if heading_font.family != body_font.family
          assign preload_heading = true
        endif
      endunless
    -%}

    {%- if preload_body or preload_heading -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endif -%}

    {%- if preload_body -%}
      {{ body_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {%- endif -%}

    {%- if preload_heading -%}
      {{ heading_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {%- endif -%}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {%- comment -%}
      Reveal on scroll. The class goes on <html> from an inline script rather
      than from the deferred one, so the hidden state is in place before the
      first paint — added after paint it would show the content and then snatch
      it back. With scripting off the class is never added and nothing hides,
      which is the whole reason the rules hang off it.
    {%- endcomment -%}
    {%- if settings.animations_reveal_on_scroll -%}
      {{ 'animations.css' | asset_url | stylesheet_tag }}
      <script>document.documentElement.classList.add('animations-on');</script>
      <script src="{{ 'animations.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body class="color-scheme-1">
    {% sections 'header-group' %}

    {{ content_for_layout }}

    {% sections 'footer-group' %}

    {%- comment -%}
      Rendered once for the whole site. The section itself returns nothing when
      the cart type is Page.
    {%- endcomment -%}
    {% section 'cart-drawer' %}
  </body>
</html>
