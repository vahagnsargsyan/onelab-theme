{% doc %}
  Dot navigation for a `<slider-carousel>`.

  Must be rendered inside the custom element, as a sibling of the track. The
  element wires the clicks, marks the current dot with `aria-current`, and hides
  the whole set when there is nothing to scroll.

  Rendered in Liquid rather than generated by JavaScript so the dots exist and
  are translated before the script runs.

  @param {number} count - How many items the track holds. One or fewer renders
    nothing, since a single slide has nowhere to go.

  @example
  {% render 'slider-dots', count: section.blocks.size %}
{% enddoc %}

{%- if count > 1 -%}
  <ul class="slider__dots list-unstyled">
    {%- for index in (1..count) -%}
      <li>
        <button
          type="button"
          class="slider__dot"
          data-slider-dot
          aria-label="{{ 'general.slider.go_to_slide' | t: index: index }}"
        ></button>
      </li>
    {%- endfor -%}
  </ul>
{%- endif -%}
