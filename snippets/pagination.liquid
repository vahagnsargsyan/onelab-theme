{% doc %}
  Pagination for any paginated list.

  Links carry `data-facet-link` so a listing that filters in place can pick them
  up; everywhere else they are ordinary links and the attribute does nothing.

  @param {object} paginate - The `paginate` object from a `{% paginate %}` tag.

  @example
  {% render 'pagination', paginate: paginate %}
{% enddoc %}

{%- if paginate.pages > 1 -%}
  <nav class="pagination" aria-label="{{ 'general.pagination.label' | t }}">
    <ul class="pagination__list list-unstyled" role="list">
      {%- if paginate.previous -%}
        <li>
          <a
            class="pagination__link pagination__link--edge"
            href="{{ paginate.previous.url }}"
            rel="prev"
            data-facet-link
          >
            {{- 'icon-caret.svg' | inline_asset_content -}}
            <span>{{ 'general.pagination.previous' | t }}</span>
          </a>
        </li>
      {%- endif -%}

      {%- for part in paginate.parts -%}
        <li>
          {%- if part.is_link -%}
            <a class="pagination__link" href="{{ part.url }}" data-facet-link>{{ part.title }}</a>
          {%- elsif part.title == paginate.current_page -%}
            <span class="pagination__link is-current" aria-current="page">{{ part.title }}</span>
          {%- else -%}
            {%- comment -%} The gap between page ranges. {%- endcomment -%}
            <span class="pagination__gap" aria-hidden="true">{{ part.title }}</span>
          {%- endif -%}
        </li>
      {%- endfor -%}

      {%- if paginate.next -%}
        <li>
          <a
            class="pagination__link pagination__link--edge pagination__link--next"
            href="{{ paginate.next.url }}"
            rel="next"
            data-facet-link
          >
            <span>{{ 'general.pagination.next' | t }}</span>
            {{- 'icon-caret.svg' | inline_asset_content -}}
          </a>
        </li>
      {%- endif -%}
    </ul>
  </nav>
{%- endif -%}
