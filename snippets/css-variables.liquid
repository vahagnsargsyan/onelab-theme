{% doc %}
  Emits the theme's design tokens as CSS custom properties, plus one @font-face
  set per unique font family.

  Font roles that share a family are emitted once. Because every role defaults to
  the same family, a default install loads 4 faces rather than 16 — which is what
  keeps the Lighthouse performance budget reachable.

  Sections and blocks must read the custom properties below, never `settings.*`
  directly, so color schemes and per-section overrides keep working.
{% enddoc %}

{% liquid
  assign font_roles = 'body,subheading,heading,accent' | split: ','
  assign emitted_families = ''

  comment
    Self-hosted families in use. A role set to one of these ignores its picker
    font entirely, so the picker face is not downloaded for it either.
    See snippets/custom-fonts.liquid — this whole mechanism is temporary.
  endcomment
  assign custom_fonts_used = ''
  for role in font_roles
    assign custom_key = 'font_' | append: role | append: '_custom'
    assign custom = settings[custom_key]
    if custom != blank and custom != 'none'
      assign custom_fonts_used = custom_fonts_used | append: custom | append: '|'
    endif
  endfor
%}

{%- capture custom_font_faces -%}
  {% render 'custom-fonts', used: custom_fonts_used %}
{%- endcapture -%}

{% style %}
  {{ custom_font_faces }}

  {%- liquid
    for role in font_roles
      assign font_key = 'font_' | append: role
      assign font = settings[font_key]

      comment
        Nothing to load from Shopify for a role that uses a self-hosted family.
      endcomment
      assign custom_key = font_key | append: '_custom'
      assign custom = settings[custom_key]
      if custom != blank and custom != 'none'
        continue
      endif

      assign fingerprint = font.family | append: '~' | append: font.weight | append: '~' | append: font.style | append: '|'

      unless emitted_families contains fingerprint
        assign emitted_families = emitted_families | append: fingerprint

        echo font | font_face: font_display: 'swap'

        assign font_bold = font | font_modify: 'weight', 'bold'
        if font_bold
          echo font_bold | font_face: font_display: 'swap'
        endif

        assign font_italic = font | font_modify: 'style', 'italic'
        if font_italic
          echo font_italic | font_face: font_display: 'swap'
        endif

        if font_bold
          assign font_bold_italic = font_bold | font_modify: 'style', 'italic'
          if font_bold_italic
            echo font_bold_italic | font_face: font_display: 'swap'
          endif
        endif
      endunless
    endfor
  -%}

  :root {
    {%- for role in font_roles %}
      {%- assign font_key = 'font_' | append: role %}
      {%- assign font = settings[font_key] %}
      {%- assign custom_key = font_key | append: '_custom' %}
      {%- case settings[custom_key] %}
        {%- when 'forum' %}
    --font-{{ role }}--family: 'Forum', {{ font.fallback_families }};
    --font-{{ role }}--style: normal;
    --font-{{ role }}--weight: 400;
        {%- else %}
    --font-{{ role }}--family: {{ font.family }}, {{ font.fallback_families }};
    --font-{{ role }}--style: {{ font.style }};
    --font-{{ role }}--weight: {{ font.weight }};
      {%- endcase %}
    {%- endfor %}

    {%- comment -%}
      Text presets. Each style resolves to five properties consumed by
      critical.css. Sizes are emitted as clamp() so one setting covers every
      breakpoint: the chosen value is the desktop maximum, and headings compress
      to 60% of it on small screens. Body text does not scale.
    {%- endcomment -%}
    {%- assign text_styles = 'paragraph,h1,h2,h3,h4,h5,h6' | split: ',' -%}
    {%- for style in text_styles %}
      {%- assign size_key = style | append: '_size' -%}
      {%- assign leading_key = style | append: '_line_height' -%}
      {%- assign tracking_key = style | append: '_letter_spacing' -%}
      {%- assign case_key = style | append: '_case' -%}
      {%- assign font_key = style | append: '_font' -%}

      {%- assign size_max = settings[size_key] | times: 1 -%}
      {%- if style == 'paragraph' -%}
        {%- assign size_min = size_max -%}
      {%- else -%}
        {%- assign size_min = size_max | times: 0.6 | round -%}
      {%- endif -%}
      {%- assign size_delta = size_max | minus: size_min -%}

      {%- case settings[leading_key] -%}
        {%- when 'tight' -%}{%- assign leading = '1.1' -%}
        {%- when 'loose' -%}{%- assign leading = '1.7' -%}
        {%- else -%}{%- assign leading = '1.4' -%}
      {%- endcase -%}

      {%- case settings[tracking_key] -%}
        {%- when 'tight' -%}{%- assign tracking = '-0.02em' -%}
        {%- when 'wide' -%}{%- assign tracking = '0.06em' -%}
        {%- else -%}{%- assign tracking = '0' -%}
      {%- endcase -%}

      {%- if settings[case_key] == 'uppercase' -%}
        {%- assign text_case = 'uppercase' -%}
      {%- else -%}
        {%- assign text_case = 'none' -%}
      {%- endif -%}

      {%- if style == 'paragraph' -%}
        {%- assign font_role = 'body' -%}
      {%- elsif settings[font_key] == 'accent' -%}
        {%- assign font_role = 'accent' -%}
      {%- else -%}
        {%- assign font_role = 'heading' -%}
      {%- endif %}
    --text-{{ style }}-family: var(--font-{{ font_role }}--family);
    --text-{{ style }}-weight: var(--font-{{ font_role }}--weight);
    --text-{{ style }}-size: clamp(
      {{ size_min }}px,
      calc({{ size_min }}px + {{ size_delta }} * ((100vw - 375px) / 1065)),
      {{ size_max }}px
    );
    --text-{{ style }}-leading: {{ leading }};
    --text-{{ style }}-tracking: {{ tracking }};
    --text-{{ style }}-case: {{ text_case }};
    {%- endfor %}

    --page-width: {{ settings.page_width }}px;
    --page-margin: {{ settings.page_margin }}px;
    --section-spacing: {{ settings.section_spacing }}px;
    --grid-gap: {{ settings.grid_gap }}px;
    --content-grid:
      minmax(var(--page-margin), 1fr)
      minmax(0, var(--page-width))
      minmax(var(--page-margin), 1fr);

    --button-radius: {{ settings.button_corner_radius }}px;
    --button-border-width: {{ settings.button_border_width }}px;
    --input-radius: {{ settings.input_corner_radius }}px;
    --input-border-width: {{ settings.input_border_width }}px;

    --focus-ring-width: {{ settings.focus_ring_width }}px;
    --focus-ring-offset: {{ settings.focus_ring_offset }}px;

    --logo-width: {{ settings.logo_width }}px;
    --card-radius: {{ settings.card_radius }}px;
  }

  {%- for scheme in settings.color_schemes %}
    {%- assign s = scheme.settings %}
    .color-{{ scheme.id }} {
      --color-background: {{ s.background }};
      --color-background-rgb: {{ s.background.red }}, {{ s.background.green }}, {{ s.background.blue }};
      {%- if s.background_gradient != blank %}
      --gradient-background: {{ s.background_gradient }};
      {%- else %}
      --gradient-background: {{ s.background }};
      {%- endif %}
      --color-foreground: {{ s.text }};
      --color-foreground-rgb: {{ s.text.red }}, {{ s.text.green }}, {{ s.text.blue }};
      --color-button: {{ s.button }};
      --color-button-text: {{ s.button_label }};
      --color-button-secondary-text: {{ s.secondary_button_label }};
      --color-border: {{ s.borders }};
      --color-shadow: {{ s.shadow }};
      --color-shadow-rgb: {{ s.shadow.red }}, {{ s.shadow.green }}, {{ s.shadow.blue }};

      color: var(--color-foreground);
      background-color: var(--color-background);
    }
  {%- endfor %}
{% endstyle %}
