{% doc %}
  Cart line items. Shared by the cart drawer and the cart page so a line looks
  and behaves the same in both.

  Every control is a real form field with a name Shopify understands, so the
  cart still works with JavaScript blocked: the quantity input posts through the
  form's update button, and Remove is a plain link to /cart/change.

  @param {string} [context] - 'drawer' or 'page'. Only affects layout classes.

  @example
  {% render 'cart-items', context: 'drawer' %}
{% enddoc %}

<ul class="cart-items cart-items--{{ context | default: 'page' }} list-unstyled" role="list">
  {%- for item in cart.items -%}
    <li class="cart-item" data-cart-line="{{ forloop.index }}">
      <a href="{{ item.url }}" class="cart-item__media" tabindex="-1" aria-hidden="true">
        {%- if item.image != blank -%}
          {{
            item.image
            | image_url: width: 300
            | image_tag:
              class: 'cart-item__image',
              widths: '80, 150, 300',
              sizes: '80px',
              alt: '',
              loading: 'lazy'
          }}
        {%- endif -%}
      </a>

      <div class="cart-item__details">
        <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>

        {%- comment -%}
          Variant options and selling plan, both required to be visible in the
          cart when they apply.
        {%- endcomment -%}
        {%- if item.product.has_only_default_variant == false -%}
          <p class="cart-item__meta">
            {%- for option in item.options_with_values -%}
              {{ option.name }}: {{ option.value }}{% unless forloop.last %}, {% endunless %}
            {%- endfor -%}
          </p>
        {%- endif -%}

        {%- if item.selling_plan_allocation -%}
          <p class="cart-item__meta">{{ item.selling_plan_allocation.selling_plan.name }}</p>
        {%- endif -%}

        {%- for property in item.properties -%}
          {%- unless property.last == blank or property.first.first == '_' -%}
            <p class="cart-item__meta">{{ property.first }}: {{ property.last }}</p>
          {%- endunless -%}
        {%- endfor -%}

        {%- if item.unit_price_measurement -%}
          <p class="cart-item__meta">
            {{ item.unit_price | money }}
            <span aria-hidden="true">/</span>
            {%- if item.unit_price_measurement.reference_value != 1 -%}
              {{ item.unit_price_measurement.reference_value }}
            {%- endif -%}
            {{ item.unit_price_measurement.reference_unit }}
          </p>
        {%- endif -%}

        {%- comment -%} Per-item discounts, required to be shown in the cart. {%- endcomment -%}
        {%- if item.line_level_discount_allocations.size > 0 -%}
          <ul class="cart-item__discounts list-unstyled" role="list">
            {%- for allocation in item.line_level_discount_allocations -%}
              <li class="cart-item__discount">
                {{ allocation.discount_application.title }}
                (&minus;{{ allocation.amount | money }})
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <div class="cart-item__controls">
          <div class="quantity">
            <button
              type="button"
              class="quantity__button"
              data-quantity-step="-1"
              aria-label="{{ 'cart.decrease' | t: title: item.product.title }}"
            >
              &minus;
            </button>

            <label for="quantity-{{ context }}-{{ forloop.index }}" class="visually-hidden">
              {{- 'cart.quantity_for' | t: title: item.product.title -}}
            </label>
            <input
              id="quantity-{{ context }}-{{ forloop.index }}"
              class="quantity__input"
              type="number"
              name="updates[]"
              value="{{ item.quantity }}"
              min="0"
              step="1"
              inputmode="numeric"
              data-quantity-input
            >

            <button
              type="button"
              class="quantity__button"
              data-quantity-step="1"
              aria-label="{{ 'cart.increase' | t: title: item.product.title }}"
            >
              +
            </button>
          </div>

          <a
            href="{{ item.url_to_remove }}"
            class="cart-item__remove"
            data-cart-remove
          >
            {{- 'cart.remove' | t -}}
            <span class="visually-hidden">{{ ' ' }}{{ item.product.title }}</span>
          </a>
        </div>
      </div>

      <p class="cart-item__price">
        {%- if item.original_line_price != item.final_line_price -%}
          <s class="cart-item__price-was">
            <span class="visually-hidden">{{ 'cart.regular_total' | t }}</span>
            {{ item.original_line_price | money }}
          </s>
        {%- endif -%}
        {{ item.final_line_price | money }}
      </p>
    </li>
  {%- endfor -%}
</ul>
