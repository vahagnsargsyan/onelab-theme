{% comment %}
  Collection product listing: toolbar, filters, grid, pagination.

  The collection title and hero live in sections/collection-banner.liquid, so
  this section is only the listing and can be reordered or restyled on its own.

  Filtering and sorting are one GET form. Every control carries the parameter
  name Shopify expects, so the page filters correctly with no script at all;
  assets/facets.js then intercepts the submit and swaps the results in place
  through the Section Rendering API. The sort control sits in the toolbar rather
  than the drawer and joins the form with a `form` attribute — the same form,
  two places on the page.

  Layout, size, appearance, borders, and padding come from the shared snippets.
  The slider reuses the shared Columns settings as items per view, so a merchant
  sets the count once and it means the same thing in both modes.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}

{% liquid
  assign s = section.settings
  assign per_page = s.products_per_page | default: 12
  assign form_id = 'facets-' | append: section.id

  assign dot_count = collection.products.size
  if dot_count > per_page
    assign dot_count = per_page
  endif

  comment
    Filters are set up in the store's search and discovery settings. With none
    set up the list is empty and the whole drawer disappears — the theme never
    depends on that being configured.
  endcomment
  assign has_filters = false
  if s.show_filters and collection.filters.size > 0
    assign has_filters = true
  endif

  assign filters_active = false
  for filter in collection.filters
    if filter.active_values.size > 0 or filter.min_value.value or filter.max_value.value
      assign filters_active = true
    endif
  endfor

  assign sort = collection.sort_by | default: collection.default_sort_by

  comment
    The roomy view is half the configured column count, so the toggle always
    means something whatever the merchant set. It never drops below one.
  endcomment
  assign columns = s.columns | default: 4
  assign roomy = columns | divided_by: 2
  if roomy < 1
    assign roomy = 1
  endif

  assign show_toolbar = false
  if s.show_view_toggle or s.show_sorting or has_filters
    assign show_toolbar = true
  endif
%}

{{ 'card.css' | asset_url | stylesheet_tag }}
{{ 'collection.css' | asset_url | stylesheet_tag }}
{%- if settings.card_quick_add != 'none' -%}
  <script src="{{ 'cart-add.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{%- if has_filters or s.show_sorting -%}
  <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{%- if s.use_slider -%}
  {{ 'slider.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'slider.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<div {% render 'layout-style', s: section.settings, class: 'collection full-width' %}>
  {% render 'layout-background', s: section.settings %}

  <div class="layout__content">
    <facet-filters
      class="collection__inner"
      data-section-id="{{ section.id }}"
      style="--columns-roomy: repeat({{ roomy }}, minmax(0, 1fr));"
    >
      {%- comment -%}
        Optional, and empty by default: the collection title is an <h1> in the
        banner section above, so anything here is a second-level heading a
        merchant has chosen to add.
      {%- endcomment -%}
      {%- if s.heading != blank -%}
        <header class="collection__header collection__header--{{ s.heading_alignment }}">
          <h2 class="collection__heading" {% render 'text-preset-style', preset: s.heading_preset %}>
            {{- s.heading -}}
          </h2>
        </header>
      {%- endif -%}

      {%- if show_toolbar -%}
        <div class="collection__toolbar">
          {%- if s.show_view_toggle -%}
            {%- comment -%}
              Two radios and a :has() rule — the density toggle needs no script,
              keeps its keyboard semantics, and cannot get out of step with what
              is on screen.
            {%- endcomment -%}
            <fieldset class="density">
              <legend class="visually-hidden">{{ 'collections.view.label' | t }}</legend>

              <label class="density__option">
                <input
                  type="radio"
                  class="visually-hidden density__input"
                  name="density-{{ section.id }}"
                  value="roomy"
                  data-density="roomy"
                >
                <span class="density__icon">{{ 'icon-grid-roomy.svg' | inline_asset_content }}</span>
                <span class="visually-hidden">{{ 'collections.view.option' | t: count: roomy }}</span>
              </label>

              <label class="density__option">
                <input
                  type="radio"
                  class="visually-hidden density__input"
                  name="density-{{ section.id }}"
                  value="dense"
                  data-density="dense"
                  checked
                >
                <span class="density__icon">{{ 'icon-grid-dense.svg' | inline_asset_content }}</span>
                <span class="visually-hidden">{{ 'collections.view.option' | t: count: columns }}</span>
              </label>
            </fieldset>
          {%- endif -%}

          <div class="collection__tools">
            {%- if s.show_sorting -%}
              <div class="sort">
                <label class="visually-hidden" for="sort-{{ section.id }}">
                  {{- 'collections.sort.label' | t -}}
                </label>
                <select
                  id="sort-{{ section.id }}"
                  class="sort__select"
                  name="sort_by"
                  form="{{ form_id }}"
                  data-facet-sort
                >
                  {%- for option in collection.sort_options -%}
                    <option value="{{ option.value }}" {% if option.value == sort %}selected{% endif %}>
                      {{- option.name -}}
                    </option>
                  {%- endfor -%}
                </select>
                {{ 'icon-caret.svg' | inline_asset_content }}

                {%- comment -%}
                  With the script running, changing the select applies the sort.
                  Without it, the customer needs something to press.
                {%- endcomment -%}
                <noscript>
                  <button type="submit" form="{{ form_id }}" class="button button--small">
                    {{- 'collections.sort.apply' | t -}}
                  </button>
                </noscript>
              </div>
            {%- endif -%}

            {%- if has_filters -%}
              <button type="button" class="button button--secondary collection__filters" data-facet-open>
                {{- 'collections.filters.open' | t -}}
              </button>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}

      {%- if has_filters -%}
        {% render 'facet-filters', results: collection, form_id: form_id %}
      {%- elsif s.show_sorting -%}
        {%- comment -%}
          No filters, but the sort control still needs a form to belong to.
        {%- endcomment -%}
        <form id="{{ form_id }}" action="{{ collection.url }}" method="get" hidden data-facet-form></form>
      {%- endif -%}

      <div class="collection__results" data-facet-results>
        {%- if collection.products.size > 0 -%}
          {%- if s.use_slider -%}
            <slider-carousel
              class="slider"{% if s.slider_loop %} loop{% endif %}
              style="--slider-per-view: {{ columns }}; --slider-per-view-mobile: {{ s.columns_mobile | default: 1 }};"
            >
              {% render 'slider-controls' %}

              <ul
                class="slider__track list-unstyled"
                data-slider-track
                tabindex="0"
                role="region"
                aria-label="{{ collection.title | escape }}"
              >
                {%- for product in collection.products limit: per_page -%}
                  <li>
                    {% render 'product-card', product: product, index: forloop.index0 %}
                  </li>
                {%- endfor -%}
              </ul>

              {%- if s.show_dots -%}
                {% render 'slider-dots', count: dot_count %}
              {%- endif -%}
            </slider-carousel>
          {%- else -%}
            {% paginate collection.products by per_page %}
              <ul class="layout__blocks collection__grid list-unstyled">
                {%- for product in collection.products -%}
                  <li>
                    {% render 'product-card', product: product, index: forloop.index0 %}
                  </li>
                {%- endfor -%}
              </ul>

              {% render 'pagination', paginate: paginate %}
            {% endpaginate %}
          {%- endif -%}

        {%- elsif filters_active -%}
          {%- comment -%}
            "Nothing matches" and "nothing here yet" are different problems, and
            only one of them has a way out.
          {%- endcomment -%}
          <div class="collection__empty">
            <p>{{ 'collections.no_matches' | t }}</p>
            <a href="{{ collection.url }}" class="button button--secondary" data-facet-clear>
              {{- 'collections.filters.clear' | t -}}
            </a>
          </div>

        {%- else -%}
          <p class="collection__empty">{{ 'collections.empty' | t }}</p>
        {%- endif -%}
      </div>
    </facet-filters>
  </div>
</div>

{% schema %}
{
  "name": "t:general.collection_products",
  "settings": [
    { "type": "header", "content": "t:general.products" },
    { "type": "inline_richtext", "id": "heading", "label": "t:labels.heading", "info": "t:info.collection_heading" },
    { "type": "select", "id": "heading_preset", "label": "t:labels.preset", "default": "h3",
      "visible_if": "{{ section.settings.heading != blank }}",
      "options": [
        { "value": "default", "label": "t:options.preset.default" },
        { "value": "paragraph", "label": "t:options.preset.paragraph" },
        { "value": "h1", "label": "t:general.heading_1" },
        { "value": "h2", "label": "t:general.heading_2" },
        { "value": "h3", "label": "t:general.heading_3" },
        { "value": "h4", "label": "t:general.heading_4" },
        { "value": "h5", "label": "t:general.heading_5" },
        { "value": "h6", "label": "t:general.heading_6" }
      ] },
    { "type": "select", "id": "heading_alignment", "label": "t:labels.heading_alignment", "default": "left",
      "visible_if": "{{ section.settings.heading != blank }}",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "center", "label": "t:options.alignment.center" },
        { "value": "right", "label": "t:options.alignment.right" }
      ] },
    { "type": "range", "id": "products_per_page", "label": "t:labels.products_per_page", "min": 4, "max": 48, "step": 4, "default": 12 },
    { "type": "checkbox", "id": "show_filters", "label": "t:labels.show_filters", "info": "t:info.show_filters", "default": true },
    { "type": "checkbox", "id": "show_sorting", "label": "t:labels.show_sorting", "default": true },
    { "type": "checkbox", "id": "show_view_toggle", "label": "t:labels.show_view_toggle", "info": "t:info.show_view_toggle", "default": true },
    { "type": "checkbox", "id": "use_slider", "label": "t:labels.use_slider", "info": "t:info.use_slider", "default": false },
    { "type": "checkbox", "id": "slider_loop", "label": "t:labels.slider_loop", "info": "t:info.slider_loop", "default": false,
      "visible_if": "{{ section.settings.use_slider }}" },
    { "type": "checkbox", "id": "show_dots", "label": "t:labels.show_dots", "default": false,
      "visible_if": "{{ section.settings.use_slider }}" },

    { "type": "header", "content": "t:general.layout" },
    { "type": "select", "id": "display", "label": "t:labels.display", "default": "grid",
      "visible_if": "{{ section.settings.use_slider == false }}",
      "options": [
        { "value": "block", "label": "t:options.display.block" },
        { "value": "flex", "label": "t:options.display.flex" },
        { "value": "grid", "label": "t:options.display.grid" }
      ] },
    { "type": "select", "id": "direction", "label": "t:labels.direction", "default": "vertical",
      "visible_if": "{{ section.settings.use_slider == false and section.settings.display == 'flex' }}",
      "options": [
        { "value": "vertical", "label": "t:options.direction.vertical" },
        { "value": "horizontal", "label": "t:options.direction.horizontal" }
      ] },
    { "type": "range", "id": "columns", "label": "t:labels.columns", "info": "t:info.columns", "min": 1, "max": 6, "step": 1, "default": 4 },
    { "type": "select", "id": "columns_mobile", "label": "t:labels.columns_mobile", "default": "2",
      "options": [
        { "value": "1", "label": "t:options.columns_mobile.one" },
        { "value": "2", "label": "t:options.columns_mobile.two" }
      ] },
    { "type": "select", "id": "alignment", "label": "t:labels.alignment", "default": "left",
      "visible_if": "{{ section.settings.use_slider == false and section.settings.display != 'block' }}",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "center", "label": "t:options.alignment.center" },
        { "value": "right", "label": "t:options.alignment.right" }
      ] },
    { "type": "select", "id": "position", "label": "t:labels.position", "default": "top",
      "visible_if": "{{ section.settings.use_slider == false and section.settings.display != 'block' }}",
      "options": [
        { "value": "top", "label": "t:options.position.top" },
        { "value": "center", "label": "t:options.position.center" },
        { "value": "bottom", "label": "t:options.position.bottom" }
      ] },
    { "type": "range", "id": "gap", "label": "t:labels.gap", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 16 },

    { "type": "header", "content": "t:general.size" },
    { "type": "select", "id": "width", "label": "t:labels.width", "default": "page",
      "options": [
        { "value": "page", "label": "t:options.width.page" },
        { "value": "full", "label": "t:options.width.full" }
      ] },
    { "type": "select", "id": "height", "label": "t:labels.height", "default": "fit",
      "options": [
        { "value": "fit", "label": "t:options.height.fit" },
        { "value": "small", "label": "t:options.height.small" },
        { "value": "medium", "label": "t:options.height.medium" },
        { "value": "large", "label": "t:options.height.large" },
        { "value": "full", "label": "t:options.height.full" }
      ] },

    { "type": "header", "content": "t:general.appearance" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1" },
    { "type": "select", "id": "background_media", "label": "t:labels.background_media", "default": "none",
      "options": [
        { "value": "none", "label": "t:options.background_media.none" },
        { "value": "image", "label": "t:options.background_media.image" },
        { "value": "video", "label": "t:options.background_media.video" }
      ] },
    { "type": "image_picker", "id": "background_image", "label": "t:labels.background_image",
      "visible_if": "{{ section.settings.background_media == 'image' }}" },
    { "type": "video", "id": "background_video", "label": "t:labels.background_video",
      "visible_if": "{{ section.settings.background_media == 'video' }}" },
    { "type": "color", "id": "background_color", "label": "t:labels.background_color", "info": "t:info.background_color" },
    { "type": "checkbox", "id": "background_overlay", "label": "t:labels.show_background_overlay", "default": false },
    { "type": "color", "id": "overlay_color", "label": "t:labels.overlay_color", "default": "#000000",
      "visible_if": "{{ section.settings.background_overlay }}" },
    { "type": "range", "id": "overlay_opacity", "label": "t:labels.overlay_opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 40,
      "visible_if": "{{ section.settings.background_overlay }}" },

    { "type": "header", "content": "t:general.borders" },
    { "type": "select", "id": "border_style", "label": "t:labels.style", "default": "none",
      "options": [
        { "value": "none", "label": "t:options.border_style.none" },
        { "value": "solid", "label": "t:options.border_style.solid" }
      ] },
    { "type": "range", "id": "border_width", "label": "t:labels.border_width", "min": 1, "max": 8, "step": 1, "unit": "px", "default": 1,
      "visible_if": "{{ section.settings.border_style == 'solid' }}" },
    { "type": "range", "id": "border_radius", "label": "t:labels.corner_radius", "min": 0, "max": 50, "step": 1, "unit": "px", "default": 0 },

    { "type": "header", "content": "t:general.animation" },
    { "type": "select", "id": "animation", "label": "t:labels.animation", "info": "t:info.animation", "default": "none",
      "options": [
        { "value": "none", "label": "t:options.animation.none" },
        { "value": "fade", "label": "t:options.animation.fade" },
        { "value": "fade_up", "label": "t:options.animation.fade_up" },
        { "value": "fade_down", "label": "t:options.animation.fade_down" },
        { "value": "zoom", "label": "t:options.animation.zoom" }
      ] },
    { "type": "checkbox", "id": "animation_stagger", "label": "t:labels.animation_stagger", "info": "t:info.animation_stagger", "default": false,
      "visible_if": "{{ section.settings.animation != 'none' }}" },

    { "type": "header", "content": "t:general.padding" },
    { "type": "range", "id": "padding_top", "label": "t:labels.padding_top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "t:labels.padding_bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_left", "label": "t:labels.padding_left", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_right", "label": "t:labels.padding_right", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 }
  ]
}
{% endschema %}
