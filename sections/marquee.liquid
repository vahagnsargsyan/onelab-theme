{% comment %}
  Scrolling banner. A row of text and images that travels continuously, and can
  be dragged to scrub or to turn it around.

  Built on a scroll container rather than a CSS transform. That is what makes
  dragging work: the pointer moves `scrollLeft` directly, touch scrolls it
  natively with no handler at all, and a mouse wheel or a trackpad swipe does
  the obvious thing. A transform-based marquee has to fight its own animation to
  do any of that.

  Only one copy of the row is in the markup. assets/marquee.js clones it until
  the track is wide enough to loop seamlessly, and hides the clones from
  assistive technology — otherwise the same three phrases would be read out over
  and over. With no script it is a single row that still scrolls by hand.

  Deviation from the canonical layout settings, per the rule in
  snippets/layout-style.liquid: Display, Use slider, Direction, Columns,
  Alignment, and Position are omitted, and the blocks are not wrapped in
  `.layout__blocks`. A marquee is a scroller, not a block layout — the row is
  the layout. Gap still comes from the shared setting.
{% endcomment %}

{% liquid
  assign s = section.settings

  comment
    Speed is 1-10 in the editor because "180 pixels a second" means nothing to
    anyone. The multiplier turns it into something the script can use.
  endcomment
  assign speed = s.speed | default: 4 | times: 15
%}

<script src="{{ 'marquee.js' | asset_url }}" defer="defer"></script>

<div {% render 'layout-style', s: section.settings, class: 'marquee full-width' %}>
  {% render 'layout-background', s: section.settings %}

  <div class="layout__content">
    <marquee-banner
      class="marquee__viewport"
      data-speed="{{ speed }}"
      data-direction="{{ s.direction }}"
      {% if s.pause_on_hover %}data-pause-on-hover{% endif %}
    >
      <ul class="marquee__list list-unstyled" role="list" data-marquee-list>
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'text' -%}
              <li
                class="marquee__item marquee__text"
                {% render 'text-preset-style', preset: block.settings.preset %}
                {{ block.shopify_attributes }}
              >
                {{- block.settings.text -}}
              </li>

            {%- when 'image' -%}
              <li class="marquee__item" {{ block.shopify_attributes }}>
                {%- if block.settings.image != blank -%}
                  {%- comment -%}
                    Both built first. A filter inside a filter's arguments is
                    not parsed as one — Liquid would read the whole thing as the
                    style string.
                  {%- endcomment -%}
                  {%- assign alt = block.settings.image.alt | default: '' -%}
                  {%- assign height_style = 'height: ' | append: block.settings.height | append: 'px;' -%}
                  {{
                    block.settings.image
                    | image_url: width: 400
                    | image_tag:
                      class: 'marquee__image',
                      widths: '100, 200, 300, 400',
                      sizes: '120px',
                      alt: alt,
                      loading: 'lazy',
                      style: height_style
                  }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'marquee__image marquee__placeholder' }}
                {%- endif -%}
              </li>

            {%- when '@app' -%}
              <li class="marquee__item" {{ block.shopify_attributes }}>{% render block %}</li>
          {%- endcase -%}
        {%- endfor -%}
      </ul>
    </marquee-banner>
  </div>
</div>

{% stylesheet %}
  /*
   * A flex row, because the script appends further copies of the list as
   * siblings. As a block container they would stack underneath each other
   * instead of continuing the row.
   */
  .marquee__viewport {
    display: flex;
    align-items: center;
    width: 100%;
    min-width: 0;
    overflow-x: auto;
    overflow-y: hidden;
    /* Dragging is the point; a scrollbar under it would be noise. */
    scrollbar-width: none;
    cursor: grab;
  }

  .marquee__viewport::-webkit-scrollbar {
    display: none;
  }

  .marquee__viewport.is-dragging {
    cursor: grabbing;
    /* Stops a drag from selecting the text it passes over. */
    user-select: none;
  }

  .marquee__list {
    display: flex;
    align-items: center;
    /* Trailing gap so the seam between copies matches every other join. */
    gap: var(--layout-gap, 2rem);
    margin-inline-end: var(--layout-gap, 2rem);
    /* Never squeezed to fit: the row is meant to be longer than the screen. */
    flex: 0 0 auto;
    width: max-content;
  }

  .marquee__item {
    flex: 0 0 auto;
  }

  .marquee__text {
    font-family: var(--text-family, inherit);
    font-weight: var(--text-weight, inherit);
    font-size: var(--text-size, inherit);
    letter-spacing: var(--text-tracking, inherit);
    text-transform: var(--text-case, none);
    white-space: nowrap;
  }

  .marquee__image {
    width: auto;
    object-fit: contain;
  }

  .marquee__placeholder {
    height: 40px;
    background-color: var(--color-border);
    fill: var(--color-background);
  }

  /*
   * A banner that never stops moving is the exact thing this preference is
   * about. It stays a row the customer can scroll by hand.
   */
  @media (prefers-reduced-motion: reduce) {
    .marquee__viewport {
      scroll-behavior: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.scrolling_banner",
  "blocks": [
    {
      "type": "text",
      "name": "t:general.text",
      "settings": [
        { "type": "inline_richtext", "id": "text", "label": "t:labels.text", "default": "t:defaults.marquee_text" },
        { "type": "select", "id": "preset", "label": "t:labels.preset", "default": "default",
          "options": [
            { "value": "default", "label": "t:options.preset.default" },
            { "value": "paragraph", "label": "t:options.preset.paragraph" },
            { "value": "h1", "label": "t:general.heading_1" },
            { "value": "h2", "label": "t:general.heading_2" },
            { "value": "h3", "label": "t:general.heading_3" },
            { "value": "h4", "label": "t:general.heading_4" },
            { "value": "h5", "label": "t:general.heading_5" },
            { "value": "h6", "label": "t:general.heading_6" }
          ] }
      ]
    },
    {
      "type": "image",
      "name": "t:general.image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "t:labels.image" },
        { "type": "range", "id": "height", "label": "t:labels.height", "min": 16, "max": 120, "step": 4, "unit": "px", "default": 40 }
      ]
    },
    { "type": "@app" }
  ],
  "settings": [
    { "type": "header", "content": "t:general.motion" },
    { "type": "select", "id": "direction", "label": "t:labels.direction", "info": "t:info.marquee_direction", "default": "left",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "right", "label": "t:options.alignment.right" }
      ] },
    { "type": "range", "id": "speed", "label": "t:labels.speed", "min": 1, "max": 10, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "pause_on_hover", "label": "t:labels.pause_on_hover", "default": true },

    { "type": "header", "content": "t:general.layout" },
    { "type": "range", "id": "gap", "label": "t:labels.gap", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 },

    { "type": "header", "content": "t:general.size" },
    { "type": "select", "id": "width", "label": "t:labels.width", "default": "full",
      "options": [
        { "value": "page", "label": "t:options.width.page" },
        { "value": "full", "label": "t:options.width.full" }
      ] },

    { "type": "header", "content": "t:general.appearance" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1" },
    { "type": "color", "id": "background_color", "label": "t:labels.background_color", "info": "t:info.background_color" },

    { "type": "header", "content": "t:general.borders" },
    { "type": "select", "id": "border_style", "label": "t:labels.style", "default": "none",
      "options": [
        { "value": "none", "label": "t:options.border_style.none" },
        { "value": "solid", "label": "t:options.border_style.solid" }
      ] },
    { "type": "range", "id": "border_width", "label": "t:labels.border_width", "min": 1, "max": 8, "step": 1, "unit": "px", "default": 1,
      "visible_if": "{{ section.settings.border_style == 'solid' }}" },
    { "type": "range", "id": "border_radius", "label": "t:labels.corner_radius", "min": 0, "max": 50, "step": 1, "unit": "px", "default": 0 },

    { "type": "header", "content": "t:general.padding" },
    { "type": "range", "id": "padding_top", "label": "t:labels.padding_top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "t:labels.padding_bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_left", "label": "t:labels.padding_left", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_right", "label": "t:labels.padding_right", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 }
  ],
  "presets": [
    {
      "name": "t:general.scrolling_banner",
      "blocks": [
        { "type": "text" },
        { "type": "image" },
        { "type": "text", "settings": { "text": "t:defaults.marquee_text_alt" } },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
