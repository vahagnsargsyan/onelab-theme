<header>
  <h2 class="header__title">
    {%- if settings.logo != blank -%}
      {%- liquid
        assign logo_sizes = settings.logo_width | append: 'px'
        assign logo_width_2x = settings.logo_width | times: 2
      -%}
      <a href="{{ routes.root_url }}" class="header__logo-link">
        {{
          settings.logo
          | image_url: width: logo_width_2x
          | image_tag:
            class: 'header__logo',
            widths: '150, 300, 450, 600',
            sizes: logo_sizes,
            alt: shop.name,
            loading: 'eager',
            fetchpriority: 'high'
        }}
      </a>
    {%- else -%}
      {{ shop.name | link_to: routes.root_url }}
    {%- endif -%}
  </h2>

  <div class="header__menu">
    {% for link in section.settings.menu.links %}
      {{ link.title | link_to: link.url }}
    {% endfor %}
  </div>

  <div class="header__icons">
    {% if shop.customer_accounts_enabled %}
      <shopify-account menu="{{ section.settings.customer_account_menu }}">
        {{ 'icon-account.svg' | inline_asset_content }}
      </shopify-account>
    {% endif %}

    <a href="{{ routes.cart_url }}">
      {% if cart.item_count > 0 %}
        <sup>{{ cart.item_count }}</sup>
      {% endif %}

      {{ 'icon-cart.svg' | inline_asset_content }}
    </a>
  </div>
</header>

{% stylesheet %}
  header {
    height: 5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  header a {
    position: relative;
    text-decoration: none;
    color: var(--color-foreground);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  header a sup {
    position: absolute;
    left: 100%;
    overflow: hidden;
    max-width: var(--page-margin);
  }
  header svg {
    width: 2rem;
  }
  .header__logo {
    display: block;
    width: var(--logo-width);
    height: auto;
  }
  header .header__menu,
  header .header__icons {
    display: flex;
    gap: 1rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}
