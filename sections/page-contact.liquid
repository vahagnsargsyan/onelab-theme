{% comment %}
  This section is used in the page.contact template to render a store page
  alongside a contact form.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/page
{% endcomment %}

<h1>{{ page.title }}</h1>

{{ page.content }}

<div class="contact">
  {% form 'contact', id: 'contact-form', class: 'contact__form' %}
    {%- if form.posted_successfully? -%}
      <p class="contact__success" role="status" tabindex="-1">
        {{ 'templates.contact.form.post_success' | t }}
      </p>
    {%- endif -%}

    {%- if form.errors -%}
      <div class="contact__errors" role="alert" tabindex="-1">
        <h2>{{ 'templates.contact.form.error_heading' | t }}</h2>
        <ul>
          {%- for field in form.errors -%}
            <li>
              {%- if field == 'form' -%}
                {{ form.errors.messages[field] }}
              {%- else -%}
                <a href="#contact-form-{{ field }}">
                  {{ form.errors.translated_fields[field] }}
                  {{ form.errors.messages[field] }}
                </a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    <div class="contact__field">
      <label for="contact-form-name">{{ 'templates.contact.form.name' | t }}</label>
      <input
        type="text"
        id="contact-form-name"
        name="contact[{{ 'templates.contact.form.name' | t }}]"
        value="{{ form.name | default: customer.name }}"
        autocomplete="name"
      >
    </div>

    <div class="contact__field">
      <label for="contact-form-email">{{ 'templates.contact.form.email' | t }}</label>
      <input
        type="email"
        id="contact-form-email"
        name="contact[email]"
        value="{{ form.email | default: customer.email }}"
        autocomplete="email"
        autocapitalize="off"
        spellcheck="false"
        required
        {% if form.errors contains 'email' %}
          aria-invalid="true"
          aria-describedby="contact-form-email-error"
        {% endif %}
      >
      {%- if form.errors contains 'email' -%}
        <small id="contact-form-email-error" class="contact__field-error">
          {{ form.errors.translated_fields.email }}
          {{ form.errors.messages.email }}
        </small>
      {%- endif -%}
    </div>

    <div class="contact__field">
      <label for="contact-form-phone">{{ 'templates.contact.form.phone' | t }}</label>
      <input
        type="tel"
        id="contact-form-phone"
        name="contact[{{ 'templates.contact.form.phone' | t }}]"
        value="{{ form.phone }}"
        autocomplete="tel"
      >
    </div>

    <div class="contact__field">
      <label for="contact-form-body">{{ 'templates.contact.form.comment' | t }}</label>
      <textarea
        id="contact-form-body"
        name="contact[{{ 'templates.contact.form.comment' | t }}]"
        rows="8"
      >{{ form.body }}</textarea>
    </div>

    <button type="submit">{{ 'templates.contact.form.send' | t }}</button>
  {% endform %}
</div>

{% stylesheet %}
  .contact__form {
    display: flex;
    flex-direction: column;
    gap: var(--grid-gap);
    max-width: 40rem;
  }
  .contact__field {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .contact__field input,
  .contact__field textarea {
    border: var(--input-border-width) solid var(--color-border);
    border-radius: var(--input-radius);
    padding: 0.75rem;
    font-family: inherit;
    font-size: inherit;
    color: inherit;
    background-color: transparent;
  }
  .contact__field-error {
    color: var(--color-foreground);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.contact",
  "settings": []
}
{% endschema %}
