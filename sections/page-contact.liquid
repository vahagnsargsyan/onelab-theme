{% comment %}
  Contact form, with an optional image beside it.

  The page title, breadcrumbs, and page content come from the `page` section
  above this one in the contact template, so this section is only the form. That
  keeps one heading on the page and lets a merchant restyle the header without
  touching the form.

  Image position is emitted as a Liquid branch, not CSS `order`. Focus order has
  to match DOM order, and reordering a grid visually breaks that silently.

  Deviation from the canonical layout settings, per the rule in
  snippets/layout-style.liquid: Display, Use slider, Direction, and the Columns
  settings are omitted — the form and the image are a fixed pair, placed by
  Image position instead.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/page
{% endcomment %}

{% liquid
  assign s = section.settings
  assign position = s.image_position | default: 'right'
  assign image = s.image

  case s.media_width
    when 'one_third'
      assign media_track = '33%'
    when 'two_thirds'
      assign media_track = '66%'
    else
      assign media_track = '50%'
  endcase

  case s.image_ratio
    when 'square'
      assign ratio = '1 / 1'
    when 'portrait'
      assign ratio = '4 / 5'
    when 'landscape'
      assign ratio = '3 / 2'
    else
      assign ratio = 'auto'
  endcase

  assign has_image = false
  if image != blank
    assign has_image = true
  endif
%}

{%- capture media -%}
  {%- if has_image -%}
    {%- liquid
      assign focal = image.presentation.focal_point | default: 'center center'
      assign focal_style = 'object-position: ' | append: focal | append: ';'
      assign alt = image.alt | default: ''
    -%}
    <div class="contact__media">
      {{
        image
        | image_url: width: 1600
        | image_tag:
          class: 'contact__image',
          widths: '375, 550, 750, 1100, 1500, 1600',
          sizes: '(min-width: 750px) 50vw, 100vw',
          alt: alt,
          loading: 'lazy',
          style: focal_style
      }}
    </div>
  {%- endif -%}
{%- endcapture -%}

<div {% render 'layout-style', s: section.settings, class: 'contact full-width' %}>
  {% render 'layout-background', s: section.settings %}

  <div class="layout__content">
    <div
      class="contact__inner contact__inner--image-{{ position }}"
      style="--contact-media-width: {{ media_track }}; --contact-image-ratio: {{ ratio }};"
    >
      {%- if position == 'top' or position == 'left' -%}
        {{ media }}
      {%- endif -%}

      <div class="contact__body">
        {%- if s.heading != blank -%}
          <h2 class="contact__heading" {% render 'text-preset-style', preset: s.heading_preset, padding_top: s.heading_padding_top, padding_bottom: s.heading_padding_bottom %}>
            {{- s.heading -}}
          </h2>
        {%- endif -%}

        {% form 'contact', id: 'contact-form', class: 'contact__form' %}
          {%- if form.posted_successfully? -%}
            <p class="contact__success" role="status" tabindex="-1">
              {{ 'templates.contact.form.post_success' | t }}
            </p>
          {%- endif -%}

          {%- if form.errors -%}
            {%- comment -%}
              A summary that links to the field at fault, focused on render, so
              the customer is told what went wrong rather than left to hunt.
            {%- endcomment -%}
            <div class="contact__errors" role="alert" tabindex="-1">
              <p class="contact__errors-heading">{{ 'templates.contact.form.error_heading' | t }}</p>
              <ul>
                {%- for field in form.errors -%}
                  <li>
                    {%- if field == 'form' -%}
                      {{ form.errors.messages[field] }}
                    {%- else -%}
                      <a href="#contact-form-{{ field }}">
                        {{ form.errors.translated_fields[field] }}
                        {{ form.errors.messages[field] }}
                      </a>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          <div class="contact__fields">
            <div class="contact__field">
              <label for="contact-form-name">
                {{ 'templates.contact.form.name' | t }}
                {%- comment -%}
                  Decorative: `required` on the input is what assistive
                  technology announces, so the asterisk would only repeat it.
                {%- endcomment -%}
                <span class="contact__required" aria-hidden="true">*</span>
              </label>
              <input
                type="text"
                id="contact-form-name"
                name="contact[{{ 'templates.contact.form.name' | t }}]"
                value="{{ form.name | default: customer.name }}"
                autocomplete="name"
                required
              >
            </div>

            <div class="contact__field">
              <label for="contact-form-email">
                {{ 'templates.contact.form.email' | t }}
                <span class="contact__required" aria-hidden="true">*</span>
              </label>
              <input
                type="email"
                id="contact-form-email"
                name="contact[email]"
                value="{{ form.email | default: customer.email }}"
                autocomplete="email"
                autocapitalize="off"
                spellcheck="false"
                required
                {% if form.errors contains 'email' %}
                  aria-invalid="true"
                  aria-describedby="contact-form-email-error"
                {% endif %}
              >
              {%- if form.errors contains 'email' -%}
                <small id="contact-form-email-error" class="contact__field-error">
                  {{ form.errors.translated_fields.email }}
                  {{ form.errors.messages.email }}
                </small>
              {%- endif -%}
            </div>

            {%- if s.show_phone -%}
              <div class="contact__field">
                <label for="contact-form-phone">
                  {{ 'templates.contact.form.phone' | t }}
                  {%- if s.require_phone -%}
                    <span class="contact__required" aria-hidden="true">*</span>
                  {%- endif -%}
                </label>
                <input
                  type="tel"
                  id="contact-form-phone"
                  name="contact[{{ 'templates.contact.form.phone' | t }}]"
                  value="{{ form.phone }}"
                  autocomplete="tel"
                  {% if s.require_phone %}required{% endif %}
                >
              </div>
            {%- endif -%}

            {%- if s.show_subject -%}
              <div class="contact__field">
                <label for="contact-form-subject">
                  {{ 'templates.contact.form.subject' | t }}
                  <span class="contact__required" aria-hidden="true">*</span>
                </label>
                <input
                  type="text"
                  id="contact-form-subject"
                  name="contact[{{ 'templates.contact.form.subject' | t }}]"
                  required
                >
              </div>
            {%- endif -%}

            <div class="contact__field contact__field--wide">
              <label for="contact-form-body">
                {{ 'templates.contact.form.comment' | t }}
                <span class="contact__required" aria-hidden="true">*</span>
              </label>
              <textarea
                id="contact-form-body"
                name="contact[{{ 'templates.contact.form.comment' | t }}]"
                rows="4"
                required
              >{{ form.body }}</textarea>
            </div>
          </div>

          <button type="submit" class="button contact__submit">
            {{- 'templates.contact.form.send' | t -}}
          </button>
        {% endform %}
      </div>

      {%- if position == 'bottom' or position == 'right' -%}
        {{ media }}
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .contact__inner {
    display: grid;
    gap: var(--layout-gap, 3rem);
    align-items: center;
    width: 100%;
    min-width: 0;
  }

  /*
   * Side by side only when the image sits beside the form. Top and bottom stay
   * a single column, and every arrangement collapses to one on small screens.
   */
  .contact__inner--image-left:has(.contact__media) {
    grid-template-columns: var(--contact-media-width) minmax(0, 1fr);
  }

  .contact__inner--image-right:has(.contact__media) {
    grid-template-columns: minmax(0, 1fr) var(--contact-media-width);
  }

  .contact__body {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    min-width: 0;
  }

  .contact__heading {
    margin: 0;
    font-family: var(--text-family, inherit);
    font-weight: var(--text-weight, inherit);
    font-size: var(--text-size, inherit);
    line-height: var(--text-leading, inherit);
    letter-spacing: var(--text-tracking, inherit);
    text-transform: var(--text-case, none);
  }

  .contact__image {
    width: 100%;
    aspect-ratio: var(--contact-image-ratio, auto);
    object-fit: cover;
  }

  .contact__form {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: 2rem;
  }

  .contact__fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.75rem 1.5rem;
    width: 100%;
  }

  .contact__field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
  }

  .contact__field--wide {
    grid-column: 1 / -1;
  }

  .contact__field label {
    font-size: var(--text-h6-size);
  }

  /*
   * Underlined fields: the border is the only chrome, so the form reads as a
   * set of ruled lines rather than a stack of boxes.
   */
  .contact__field input,
  .contact__field textarea {
    min-height: 44px;
    padding: 0 0 0.5rem;
    font: inherit;
    color: inherit;
    background-color: transparent;
    border: 0;
    border-block-end: var(--input-border-width) solid var(--color-border);
    border-radius: 0;
  }

  .contact__field textarea {
    resize: vertical;
  }

  .contact__field input:focus-visible,
  .contact__field textarea:focus-visible {
    outline: var(--focus-ring-width) solid currentColor;
    outline-offset: var(--focus-ring-offset);
  }

  .contact__required {
    opacity: 0.6;
  }

  .contact__field-error {
    font-size: var(--text-h6-size);
  }

  .contact__errors,
  .contact__success {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
  }

  .contact__errors-heading {
    margin-block-end: 0.5rem;
    font-family: var(--text-h6-family);
    font-size: var(--text-h6-size);
  }

  @media (max-width: 749px) {
    .contact__inner--image-left:has(.contact__media),
    .contact__inner--image-right:has(.contact__media) {
      grid-template-columns: minmax(0, 1fr);
    }

    .contact__fields {
      grid-template-columns: minmax(0, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.contact",
  "settings": [
    { "type": "header", "content": "t:general.content" },
    { "type": "inline_richtext", "id": "heading", "label": "t:labels.heading", "default": "t:defaults.write_to_us" },
    { "type": "select", "id": "heading_preset", "label": "t:labels.preset", "default": "h3",
      "options": [
        { "value": "default", "label": "t:options.preset.default" },
        { "value": "paragraph", "label": "t:options.preset.paragraph" },
        { "value": "h1", "label": "t:general.heading_1" },
        { "value": "h2", "label": "t:general.heading_2" },
        { "value": "h3", "label": "t:general.heading_3" },
        { "value": "h4", "label": "t:general.heading_4" },
        { "value": "h5", "label": "t:general.heading_5" },
        { "value": "h6", "label": "t:general.heading_6" }
      ] },
    { "type": "checkbox", "id": "show_phone", "label": "t:labels.show_phone", "default": true },
    { "type": "checkbox", "id": "require_phone", "label": "t:labels.require_phone", "info": "t:info.require_phone", "default": true,
      "visible_if": "{{ section.settings.show_phone }}" },
    { "type": "checkbox", "id": "show_subject", "label": "t:labels.show_subject", "default": true },

    { "type": "header", "content": "t:general.media" },
    { "type": "image_picker", "id": "image", "label": "t:labels.image" },
    { "type": "select", "id": "image_position", "label": "t:labels.image_position", "info": "t:info.contact_image_position", "default": "right",
      "options": [
        { "value": "top", "label": "t:options.position.top" },
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "right", "label": "t:options.alignment.right" },
        { "value": "bottom", "label": "t:options.position.bottom" }
      ] },
    { "type": "select", "id": "media_width", "label": "t:labels.media_width", "default": "half",
      "visible_if": "{{ section.settings.image_position == 'left' or section.settings.image_position == 'right' }}",
      "options": [
        { "value": "one_third", "label": "t:options.media_width.one_third" },
        { "value": "half", "label": "t:options.media_width.half" },
        { "value": "two_thirds", "label": "t:options.media_width.two_thirds" }
      ] },
    { "type": "select", "id": "image_ratio", "label": "t:labels.image_ratio", "default": "landscape",
      "options": [
        { "value": "adapt", "label": "t:options.image_ratio.adapt" },
        { "value": "square", "label": "t:options.image_ratio.square" },
        { "value": "portrait", "label": "t:options.image_ratio.portrait" },
        { "value": "landscape", "label": "t:options.image_ratio.landscape" }
      ] },

    { "type": "range", "id": "heading_padding_top", "label": "t:labels.heading_padding_top", "info": "t:info.heading_padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "heading_padding_bottom", "label": "t:labels.heading_padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },

    { "type": "header", "content": "t:general.layout" },
    { "type": "range", "id": "gap", "label": "t:labels.gap", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },

    { "type": "header", "content": "t:general.size" },
    { "type": "select", "id": "width", "label": "t:labels.width", "default": "page",
      "options": [
        { "value": "page", "label": "t:options.width.page" },
        { "value": "full", "label": "t:options.width.full" }
      ] },

    { "type": "header", "content": "t:general.appearance" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1" },
    { "type": "select", "id": "background_media", "label": "t:labels.background_media", "default": "none",
      "options": [
        { "value": "none", "label": "t:options.background_media.none" },
        { "value": "image", "label": "t:options.background_media.image" },
        { "value": "video", "label": "t:options.background_media.video" }
      ] },
    { "type": "image_picker", "id": "background_image", "label": "t:labels.background_image",
      "visible_if": "{{ section.settings.background_media == 'image' }}" },
    { "type": "video", "id": "background_video", "label": "t:labels.background_video",
      "visible_if": "{{ section.settings.background_media == 'video' }}" },
    { "type": "color", "id": "background_color", "label": "t:labels.background_color", "info": "t:info.background_color" },
    { "type": "checkbox", "id": "background_overlay", "label": "t:labels.show_background_overlay", "default": false },
    { "type": "color", "id": "overlay_color", "label": "t:labels.overlay_color", "default": "#000000",
      "visible_if": "{{ section.settings.background_overlay }}" },
    { "type": "range", "id": "overlay_opacity", "label": "t:labels.overlay_opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 40,
      "visible_if": "{{ section.settings.background_overlay }}" },

    { "type": "header", "content": "t:general.borders" },
    { "type": "select", "id": "border_style", "label": "t:labels.style", "default": "none",
      "options": [
        { "value": "none", "label": "t:options.border_style.none" },
        { "value": "solid", "label": "t:options.border_style.solid" }
      ] },
    { "type": "range", "id": "border_width", "label": "t:labels.border_width", "min": 1, "max": 8, "step": 1, "unit": "px", "default": 1,
      "visible_if": "{{ section.settings.border_style == 'solid' }}" },
    { "type": "range", "id": "border_radius", "label": "t:labels.corner_radius", "min": 0, "max": 50, "step": 1, "unit": "px", "default": 0 },

    { "type": "header", "content": "t:general.animation" },
    { "type": "select", "id": "animation", "label": "t:labels.animation", "info": "t:info.animation", "default": "none",
      "options": [
        { "value": "none", "label": "t:options.animation.none" },
        { "value": "fade", "label": "t:options.animation.fade" },
        { "value": "fade_up", "label": "t:options.animation.fade_up" },
        { "value": "fade_down", "label": "t:options.animation.fade_down" },
        { "value": "zoom", "label": "t:options.animation.zoom" }
      ] },
    { "type": "checkbox", "id": "animation_stagger", "label": "t:labels.animation_stagger", "info": "t:info.animation_stagger", "default": false,
      "visible_if": "{{ section.settings.animation != 'none' }}" },

    { "type": "header", "content": "t:general.padding" },
    { "type": "range", "id": "padding_top", "label": "t:labels.padding_top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "t:labels.padding_bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_left", "label": "t:labels.padding_left", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_right", "label": "t:labels.padding_right", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 }
  ]
}
{% endschema %}
