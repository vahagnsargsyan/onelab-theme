{% comment %}
  Product page.

  Media on one side, an info column built from blocks on the other. Blocks are
  local to this section because they are product-specific, and `@app` is among
  them — the Theme Store requires app blocks in the main product section, with
  Custom Liquid blocks as further insertion points.

  Gallery layout is a setting: grid tiles every image, carousel shows one large
  image with thumbnails. Both open the same lightbox.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/product
{% endcomment %}

{% liquid
  assign s = section.settings
  assign variant = product.selected_or_first_available_variant

  case s.media_width
    when 'one_third'
      assign media_track = '33%'
    when 'two_thirds'
      assign media_track = '66%'
    else
      assign media_track = '55%'
  endcase

  case s.tabs_alignment
    when 'left'
      assign tabs_justify = 'flex-start'
    when 'right'
      assign tabs_justify = 'flex-end'
    else
      assign tabs_justify = 'center'
  endcase
%}

{{ 'product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product.js' | asset_url }}" defer="defer"></script>

<div {% render 'layout-style', s: section.settings, class: 'product-section full-width' %}>
  {% render 'layout-background', s: section.settings %}

  <div class="layout__content">
<div class="product product--gallery-{{ s.gallery_layout }}" style="--product-media-width: {{ media_track }};">
  {%- if s.show_breadcrumbs -%}
    {% render 'breadcrumbs' %}
  {%- endif -%}

  <div class="product__layout">
    <div class="product__media">
      {% render 'product-media-gallery', product: product, layout: s.gallery_layout %}
    </div>

    <div class="product__info">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'title' -%}
            {%- comment -%}
              Always an <h1>: it is the page's one top-level heading. The
              preset changes how large it looks, never what it means.
            {%- endcomment -%}
            <h1
              class="product__title"
              {% render 'text-preset-style', preset: block.settings.preset, alignment: block.settings.alignment %}
              {{ block.shopify_attributes }}
            >
              {{- product.title -}}
            </h1>

          {%- when 'price' -%}
            <div class="product__price" data-product-price {{ block.shopify_attributes }}>
              {% render 'product-price', variant: variant, show_badge: block.settings.show_badge %}
            </div>

          {%- when 'quantity' -%}
            <div class="product__quantity" {{ block.shopify_attributes }}>
              <label for="product-quantity" class="product__label">{{ 'products.quantity' | t }}</label>
              <div class="quantity">
                <button
                  type="button"
                  class="quantity__button"
                  data-quantity-step="-1"
                  aria-label="{{ 'products.decrease' | t }}"
                >
                  &minus;
                </button>
                <input
                  id="product-quantity"
                  class="quantity__input"
                  type="number"
                  name="quantity"
                  form="product-form-{{ section.id }}"
                  value="1"
                  min="1"
                  step="1"
                  inputmode="numeric"
                  data-quantity-input
                >
                <button
                  type="button"
                  class="quantity__button"
                  data-quantity-step="1"
                  aria-label="{{ 'products.increase' | t }}"
                >
                  +
                </button>
              </div>
            </div>

          {%- when 'variant_picker' -%}
            <div {{ block.shopify_attributes }}>
              {% render 'product-variant-picker', product: product, block: block, section_id: section.id %}
            </div>

          {%- when 'description' -%}
            <div class="product__description rte" {{ block.shopify_attributes }}>
              {{ product.description }}
            </div>

          {%- when 'inventory' -%}
            <div class="product__inventory" data-product-inventory {{ block.shopify_attributes }}>
              {%- if variant.available -%}
                <p class="inventory">{{ 'products.in_stock' | t }}</p>
                {%- comment -%}
                  A bar, not a number. Publishing exact stock counts is how
                  themes drift into false-urgency territory; this only says
                  "plenty" or "running low".
                {%- endcomment -%}
                {%- if variant.inventory_management != blank and variant.inventory_quantity > 0 -%}
                  {%- liquid
                    assign level = variant.inventory_quantity | times: 100 | divided_by: block.settings.inventory_threshold
                    if level > 100
                      assign level = 100
                    endif
                  -%}
                  <div class="inventory__track" aria-hidden="true">
                    <div class="inventory__fill" style="width: {{ level }}%;"></div>
                  </div>
                {%- endif -%}
              {%- else -%}
                <p class="inventory inventory--out">{{ 'products.sold_out' | t }}</p>
              {%- endif -%}
            </div>

          {%- when 'buy_buttons' -%}
            <div class="product__buy" data-product-buy {{ block.shopify_attributes }}>
              <product-form
                data-added-message="{{ 'products.card.added' | t: title: product.title | escape }}"
                data-error-message="{{ 'products.card.add_error' | t | escape }}"
              >
                {%- comment -%}
                  The id is built first. A filter inside a tag's arguments is
                  not parsed as a filter — Liquid would read the appended string
                  as the form type and reject it.
                {%- endcomment -%}
                {%- assign product_form_id = 'product-form-' | append: section.id -%}
                {%- form 'product', product, id: product_form_id, novalidate: 'novalidate' -%}
                  <input type="hidden" name="id" value="{{ variant.id }}">

                  {%- if product.gift_card? -%}
                    {%- comment -%}
                      Gift cards must be able to carry a recipient, which is a
                      Theme Store requirement in its own right.
                    {%- endcomment -%}
                    <div class="product__recipient">
                      <label for="recipient-email">{{ 'products.gift_card.email' | t }}</label>
                      <input id="recipient-email" type="email" name="properties[Recipient email]" autocomplete="email">

                      <label for="recipient-name">{{ 'products.gift_card.name' | t }}</label>
                      <input id="recipient-name" type="text" name="properties[Recipient name]">

                      <label for="recipient-message">{{ 'products.gift_card.message' | t }}</label>
                      <textarea id="recipient-message" name="properties[Message]" rows="3"></textarea>

                      <label for="recipient-send-on">{{ 'products.gift_card.send_on' | t }}</label>
                      <input id="recipient-send-on" type="date" name="properties[Send on]">
                    </div>
                  {%- endif -%}

                  <button
                    type="submit"
                    name="add"
                    class="button product__add"
                    data-add-button
                    {% unless variant.available %}
                      disabled
                    {% endunless %}
                  >
                    {%- if variant.available -%}
                      {{ 'products.add_to_cart' | t }}
                    {%- else -%}
                      {{ 'products.sold_out' | t }}
                    {%- endif -%}
                  </button>

                  {%- comment -%}
                    Accelerated checkout, on by default. Branded colors are
                    never restyled — the requirements forbid it.
                  {%- endcomment -%}
                  {%- if block.settings.show_dynamic_checkout -%}
                    {{ form | payment_button }}
                  {%- endif -%}

                  {%- comment -%} Shop Pay Installments banner. {%- endcomment -%}
                  {{ form | payment_terms }}
                {%- endform -%}
              </product-form>
            </div>

          {%- when 'pickup' -%}
            {%- comment -%}
              Rendered straight from `variant.store_availabilities`, so it needs
              no script and is correct on first paint. product.js swaps this
              block on a variant change along with price and availability.
            {%- endcomment -%}
            <div class="product__pickup" data-product-pickup {{ block.shopify_attributes }}>
              {%- if variant.store_availabilities.size > 0 -%}
                <ul class="pickup list-unstyled" role="list">
                  {%- for availability in variant.store_availabilities -%}
                    <li class="pickup__item">
                      {%- if availability.available -%}
                        {{ 'products.pickup.available_at_html' | t: location: availability.location.name }}
                        {%- if availability.pick_up_time != blank -%}
                          <span class="pickup__time">{{ availability.pick_up_time }}</span>
                        {%- endif -%}
                      {%- else -%}
                        {{ 'products.pickup.unavailable_at_html' | t: location: availability.location.name }}
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>

          {%- when 'complementary' -%}
            <div class="product__complementary" {{ block.shopify_attributes }}>
              <h2 class="product__label">{{ block.settings.heading }}</h2>
              {%- comment -%}
                Complementary products come from Shopify's recommendations with
                intent "complementary", which is the Search & Discovery data —
                not a hand-picked list, and not an app dependency.
              {%- endcomment -%}
              {% assign complementary_url = routes.product_recommendations_url
                | append: '?section_id=' | append: section.id
                | append: '&product_id=' | append: product.id
                | append: '&limit=' | append: block.settings.limit
                | append: '&intent=complementary'
              %}
              <div data-complementary data-url="{{ complementary_url }}"></div>
            </div>

          {%- when 'text' -%}
            <div
              class="product__text rte"
              {% render 'text-preset-style', preset: block.settings.preset, alignment: block.settings.alignment %}
              {{ block.shopify_attributes }}
            >
              {{ block.settings.text }}
            </div>

          {%- when '@app' -%}
            {% render block %}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

  {%- comment -%}
    Tabs sit below both columns, across the section, so a long description does
    not stretch the media column. Every panel is rendered and every tab is a
    real anchor link to one, so the content is reachable with scripting off;
    the script upgrades the strip in place to the ARIA tabs pattern.
  {%- endcomment -%}
  {%- assign tab_blocks = section.blocks | where: 'type', 'tab' -%}
  {%- if tab_blocks.size > 0 -%}
    <product-tabs
      class="product-tabs{% if s.show_divider %} product-tabs--divided{% endif %}"
      style="--tabs-justify: {{ tabs_justify }};"
    >
      <div class="product-tabs__list" data-tab-list {% render 'text-preset-style', preset: s.tabs_preset %}>
        {%- for block in tab_blocks -%}
          {%- capture tab_body %}{% render 'product-tab-content', block: block, product: product %}{% endcapture -%}
          {%- if tab_body != blank or request.design_mode -%}
            <a
              id="tab-{{ section.id }}-{{ block.id }}"
              class="product-tabs__tab"
              href="#panel-{{ section.id }}-{{ block.id }}"
              aria-controls="panel-{{ section.id }}-{{ block.id }}"
              data-tab
            >
              {{- block.settings.heading -}}
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- for block in tab_blocks -%}
        {%- capture tab_body %}{% render 'product-tab-content', block: block, product: product %}{% endcapture -%}
        {%- comment -%}
          An empty tab is dropped on the storefront but kept in the editor, so
          a merchant can still select a tab they have not filled in yet.
        {%- endcomment -%}
        {%- if tab_body != blank or request.design_mode -%}
          <div
            id="panel-{{ section.id }}-{{ block.id }}"
            class="product-tabs__panel"
            aria-labelledby="tab-{{ section.id }}-{{ block.id }}"
            data-panel
            {{ block.shopify_attributes }}
          >
            {%- comment -%}
              Repeats the tab label for anyone without the script. The tabs
              pattern makes the strip the heading, so it is hidden once the
              element upgrades.
            {%- endcomment -%}
            <h2 class="product__label product-tabs__heading" data-panel-heading>{{ block.settings.heading }}</h2>
            <div class="product-tabs__content rte">{{ tab_body }}</div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </product-tabs>
  {%- endif -%}
</div>
  </div>
</div>

{% schema %}
{
  "name": "t:general.product",
  "blocks": [
    {
      "type": "title",
      "name": "t:labels.title",
      "limit": 1,
      "settings": [
        { "type": "select", "id": "preset", "label": "t:labels.preset", "default": "h3",
          "options": [
            { "value": "default", "label": "t:options.preset.default" },
            { "value": "paragraph", "label": "t:options.preset.paragraph" },
            { "value": "h1", "label": "t:general.heading_1" },
            { "value": "h2", "label": "t:general.heading_2" },
            { "value": "h3", "label": "t:general.heading_3" },
            { "value": "h4", "label": "t:general.heading_4" },
            { "value": "h5", "label": "t:general.heading_5" },
            { "value": "h6", "label": "t:general.heading_6" }
          ] },
        { "type": "select", "id": "alignment", "label": "t:labels.alignment", "default": "left",
          "options": [
            { "value": "left", "label": "t:options.alignment.left" },
            { "value": "center", "label": "t:options.alignment.center" },
            { "value": "right", "label": "t:options.alignment.right" }
          ] }
      ]
    },
    {
      "type": "price",
      "name": "t:general.price",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_badge", "label": "t:labels.show_sale_badge", "default": true }
      ]
    },
    { "type": "quantity", "name": "t:labels.quantity", "limit": 1 },
    { "type": "variant_picker", "name": "t:general.variants", "limit": 1 },
    { "type": "description", "name": "t:labels.description", "limit": 1 },
    {
      "type": "inventory",
      "name": "t:general.inventory",
      "limit": 1,
      "settings": [
        { "type": "range", "id": "inventory_threshold", "label": "t:labels.inventory_threshold", "info": "t:info.inventory_threshold", "min": 1, "max": 50, "step": 1, "default": 10 }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "t:general.buy_buttons",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_dynamic_checkout", "label": "t:labels.show_dynamic_checkout", "info": "t:info.show_dynamic_checkout", "default": true }
      ]
    },
    { "type": "pickup", "name": "t:general.pickup", "limit": 1 },
    {
      "type": "complementary",
      "name": "t:general.complementary",
      "limit": 1,
      "settings": [
        { "type": "inline_richtext", "id": "heading", "label": "t:labels.heading", "default": "t:defaults.pairs_well_with" },
        { "type": "range", "id": "limit", "label": "t:labels.products_to_show", "min": 1, "max": 6, "step": 1, "default": 3 }
      ]
    },
    {
      "type": "text",
      "name": "t:general.text",
      "settings": [
        { "type": "richtext", "id": "text", "label": "t:labels.text" },
        { "type": "select", "id": "preset", "label": "t:labels.preset", "default": "default",
          "options": [
            { "value": "default", "label": "t:options.preset.default" },
            { "value": "paragraph", "label": "t:options.preset.paragraph" },
            { "value": "h1", "label": "t:general.heading_1" },
            { "value": "h2", "label": "t:general.heading_2" },
            { "value": "h3", "label": "t:general.heading_3" },
            { "value": "h4", "label": "t:general.heading_4" },
            { "value": "h5", "label": "t:general.heading_5" },
            { "value": "h6", "label": "t:general.heading_6" }
          ] },
        { "type": "select", "id": "alignment", "label": "t:labels.alignment", "default": "left",
          "options": [
            { "value": "left", "label": "t:options.alignment.left" },
            { "value": "center", "label": "t:options.alignment.center" },
            { "value": "right", "label": "t:options.alignment.right" }
          ] }
      ]
    },
    {
      "type": "tab",
      "name": "t:general.tab",
      "settings": [
        { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "t:defaults.tab_description" },
        { "type": "select", "id": "content", "label": "t:labels.content_source", "default": "text",
          "options": [
            { "value": "description", "label": "t:options.tab_content.description" },
            { "value": "text", "label": "t:options.tab_content.text" },
            { "value": "page", "label": "t:options.tab_content.page" }
          ] },
        { "type": "richtext", "id": "text", "label": "t:labels.text",
          "visible_if": "{{ block.settings.content == 'text' }}" },
        { "type": "page", "id": "page", "label": "t:labels.page", "info": "t:info.tab_page" }
      ]
    },
    { "type": "@app" }
  ],
  "settings": [
    { "type": "header", "content": "t:general.media" },
    {
      "type": "select",
      "id": "gallery_layout",
      "label": "t:labels.gallery_layout",
      "default": "grid",
      "options": [
        { "value": "grid", "label": "t:options.gallery_layout.grid" },
        { "value": "carousel", "label": "t:options.gallery_layout.carousel" }
      ]
    },
    { "type": "select", "id": "media_width", "label": "t:labels.media_width", "default": "half",
      "options": [
        { "value": "one_third", "label": "t:options.media_width.one_third" },
        { "value": "half", "label": "t:options.media_width.half" },
        { "value": "two_thirds", "label": "t:options.media_width.two_thirds" }
      ] },
    { "type": "checkbox", "id": "show_breadcrumbs", "label": "t:labels.show_breadcrumbs", "default": true },

    { "type": "header", "content": "t:general.tabs" },
    { "type": "select", "id": "tabs_alignment", "label": "t:labels.alignment", "default": "center",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "center", "label": "t:options.alignment.center" },
        { "value": "right", "label": "t:options.alignment.right" }
      ] },
    { "type": "select", "id": "tabs_preset", "label": "t:labels.preset", "default": "default",
      "options": [
            { "value": "default", "label": "t:options.preset.default" },
            { "value": "paragraph", "label": "t:options.preset.paragraph" },
            { "value": "h1", "label": "t:general.heading_1" },
            { "value": "h2", "label": "t:general.heading_2" },
            { "value": "h3", "label": "t:general.heading_3" },
            { "value": "h4", "label": "t:general.heading_4" },
            { "value": "h5", "label": "t:general.heading_5" },
            { "value": "h6", "label": "t:general.heading_6" }
          ] },
    { "type": "checkbox", "id": "show_divider", "label": "t:labels.show_divider", "default": true },

    { "type": "header", "content": "t:general.layout" },
    { "type": "range", "id": "gap", "label": "t:labels.gap", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },

    { "type": "header", "content": "t:general.size" },
    { "type": "select", "id": "width", "label": "t:labels.width", "default": "page",
      "options": [
        { "value": "page", "label": "t:options.width.page" },
        { "value": "full", "label": "t:options.width.full" }
      ] },

    { "type": "header", "content": "t:general.appearance" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1" },
    { "type": "select", "id": "background_media", "label": "t:labels.background_media", "default": "none",
      "options": [
        { "value": "none", "label": "t:options.background_media.none" },
        { "value": "image", "label": "t:options.background_media.image" },
        { "value": "video", "label": "t:options.background_media.video" }
      ] },
    { "type": "image_picker", "id": "background_image", "label": "t:labels.background_image",
      "visible_if": "{{ section.settings.background_media == 'image' }}" },
    { "type": "video", "id": "background_video", "label": "t:labels.background_video",
      "visible_if": "{{ section.settings.background_media == 'video' }}" },
    { "type": "color", "id": "background_color", "label": "t:labels.background_color", "info": "t:info.background_color" },
    { "type": "checkbox", "id": "background_overlay", "label": "t:labels.show_background_overlay", "default": false },
    { "type": "color", "id": "overlay_color", "label": "t:labels.overlay_color", "default": "#000000",
      "visible_if": "{{ section.settings.background_overlay }}" },
    { "type": "range", "id": "overlay_opacity", "label": "t:labels.overlay_opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 40,
      "visible_if": "{{ section.settings.background_overlay }}" },

    { "type": "header", "content": "t:general.borders" },
    { "type": "select", "id": "border_style", "label": "t:labels.style", "default": "none",
      "options": [
        { "value": "none", "label": "t:options.border_style.none" },
        { "value": "solid", "label": "t:options.border_style.solid" }
      ] },
    { "type": "range", "id": "border_width", "label": "t:labels.border_width", "min": 1, "max": 8, "step": 1, "unit": "px", "default": 1,
      "visible_if": "{{ section.settings.border_style == 'solid' }}" },
    { "type": "range", "id": "border_radius", "label": "t:labels.corner_radius", "min": 0, "max": 50, "step": 1, "unit": "px", "default": 0 },

    { "type": "header", "content": "t:general.padding" },
    { "type": "range", "id": "padding_top", "label": "t:labels.padding_top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "t:labels.padding_bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_left", "label": "t:labels.padding_left", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_right", "label": "t:labels.padding_right", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 }
  ],
  "presets": [
    {
      "name": "t:general.product",
      "blocks": [
        { "type": "title" },
        { "type": "price" },
        { "type": "quantity" },
        { "type": "variant_picker" },
        { "type": "description" },
        { "type": "inventory" },
        { "type": "buy_buttons" },
        { "type": "complementary" },
        { "type": "tab" }
      ]
    }
  ]
}
{% endschema %}
