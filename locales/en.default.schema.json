  "info": {
    "animation": "Applies as the section comes into view. Needs Reveal sections on scroll, in the Animations group of theme settings.",
    "animation_duration": "How long a section takes to arrive. Applies when Reveal sections on scroll is on.",
    "animation_stagger": "Each item in the section arrives after the one before it, rather than the whole section at once.",
    "animation_stagger_delay": "How long each item waits behind the one before it.",
    "animations_reveal": "Lets sections animate as they come into view. Each section chooses its own animation, and none is set by default. Turning this off removes the code from every page. Ignored for anyone whose system asks for reduced motion.",
    "background_color": "Leave empty to use the color scheme background.",
    "background_fixed": "The image or video stays in place while the page scrolls over it. Shown as a normal background to visitors who turn on reduced motion.",
    "block_background_color": "Leave empty to let the section background show through.",
    "body_padding": "Room inside the article panel. The top value is added to the overlap, so the panel keeps its lift over the image.",
    "border_color": "Leave empty to use the color scheme border color.",
    "bottom_text": "Shown above the copyright line, across the full width.",
    "bundle_collection": "Used only when no products are chosen above.",
    "bundle_products": "Left empty, the bundle offers the collection below instead.",
    "bundle_size": "How many different products make a bundle. Each one can be added in any quantity.",
    "button_link": "Left empty, the button shows but leads nowhere.",
    "buy_buttons_color_scheme": "Colors Add to cart and Buy it now, not the area behind them.",
    "caption_placement": "Where the caption sits on the image. A soft shade is drawn behind it so it stays readable over any photograph.",
    "card_swatch_option": "Used only when your product options have no swatches set up. The option with this name is used instead, and each value is read as a color name — so Gold and Silver work, and Rose Quartz does not. Setting up real swatches in your product options is the better fix.",
    "card_title_position": "On the image moves the whole card content with it, count included, and draws a soft shade behind the text so it stays readable over any picture.",
    "card_show_swatches": "Shown for products with an option that has swatches set up. Hovering one previews that color; tapping it opens the product in that color.",
    "card_hover_image": "Products with more than one image fade to the second one. Nothing changes on touchscreens, which have no hover.",
    "card_image_fit": "Applies when the image ratio is not set to adapt.",
    "card_image_ratio": "Applies to the cards in this section only. Theme default follows the image ratio in the Product cards settings.",
    "cart_type": "Page opens the cart page. Drawer slides in from the side. Popover confirms the add without covering the page.",
    "collection_heading": "Optional. The collection title is already shown by the banner section above.",
    "collections_source": "Leave empty to show every collection in the store, newest first.",
    "column_max_width": "Zero sizes the column to its own content instead.",
    "columns": "Items shown in each row. Applies when Display is Grid, or Flex set to Horizontal, and sets items per view for a slider.",
    "comparison_label": "Names this image for screen readers, and on the image when labels are shown.",
    "comparison_option_value": "An option value such as Gold, to show and sell that variant on this side. Leave empty to let the customer choose.",
    "comparison_product": "Shown beside the images while this image takes up more than half of the frame.",
    "comparison_ratio": "Both images are cropped to this shape so they line up at the handle.",
    "contact_image_position": "Where the image sits in relation to the form.",
    "content_spacing": "Spread pins the heading to the top and the rest to the bottom, when the section is tall enough.",
    "cover_image": "Shown until the video starts, and in place of it for anyone whose system asks for reduced motion. Leave empty to use the video's own first frame.",
    "custom_font": "Replaces the font above with one bundled with the theme. Chosen for brand fonts that Shopify's library does not carry.",
    "custom_liquid": "Add app snippets or other Liquid code to create advanced customizations.",
    "custom_width": "Never wider than the space the block sits in, so it stays inside its column on small screens.",
    "edge_border": "A line above the band, below it, or both. The Borders group below draws a box on all four sides instead.",
    "exclusive": "Opening one question closes whichever was open. Older browsers let more than one stay open.",
    "featured_color_scheme": "Used for the text over the featured photograph. Pick one that reads against it.",
    "favicon": "Scaled down to 32 x 32px.",
    "focus_accessibility": "The focus outline shows keyboard customers where they are on the page. Keep it visible so the storefront stays usable without a mouse.",
    "font_performance": "Roles that share a font family load once. Using fewer families keeps the storefront fast.",
    "footer_block_typography": "Applies to this column only. Same as footer keeps the footer's Typography settings.",
    "free_price_label": "Shown for every zero-priced variant. Leave blank to show the translated Free label; a variant's custom.price_label metafield takes priority.",
    "free_shipping_threshold": "In your store currency, without the symbol.",
    "gallery_layout_mobile": "Used below 990px wide, where the product page is one column. Slideshow and Carousel show one item at a time. Grid shows two columns and Stacked shows one.",
    "header_padding_inline": "Overrides the page margin. Zero keeps the header lined up with the rest of the page.",
    "heading_color": "Leave empty to use the color scheme text color.",
    "heading_max_width": "Zero lets the title run the full width of its column.",
    "heading_padding": "Room around the title on its own. The section padding moves everything, and the gap moves every item equally.",
    "heading_position": "Above keeps the heading apart from the text so Content spacing can separate them. With the text keeps them together as one block.",
    "hidden_title": "When hidden, the title is removed from view but stays in the page for search engines and screen readers.",
    "image_direction": "How the panel's menu images are arranged. Applies to all of them at once, not one by one.",
    "image_map_image": "Choose the image to mark. Write descriptive alt text for the overall image, then use each marker's title and text for its details.",
    "image_map_hover_image": "Shown over the main image on hover, focus, or when a marker is open. Keep its framing aligned; the main image supplies the screen-reader description.",
    "image_hover_image": "On devices with a mouse, this image appears while the pointer is over the Image block. Touchscreens keep the main image.",
    "image_marker_title": "Enter both a title and text to make this marker interactive. The title is also its accessible name.",
    "image_marker_text": "Shown below the title on hover, keyboard focus, or when the marker is opened.",
    "image_marker_horizontal_position": "Measured from the left edge of the image. The marker stays aligned as the image resizes.",
    "image_marker_vertical_position": "Measured from the top edge of the image. The marker stays aligned as the image resizes.",
    "image_overlap": "How far the article panel lifts over the image. Set to zero to sit the panel below it. Always zero on small screens.",
    "image_position": "Which side of the section the main image sits on. The text takes the other side.",
    "instagram_item_link": "Leave empty to use the profile link.",
    "instagram_not_a_feed": "Images are uploaded here, not pulled from Instagram. A live feed needs a third-party app.",
    "inventory_threshold": "The bar fills completely at or above this quantity. No exact count is ever shown.",
    "marquee_direction": "Which way the banner travels. Dragging it turns it around.",
    "mega_columns": "How many columns the panel aims for. The columns themselves come from the menu.",
    "menu_colors": "Used for desktop dropdowns and mega menu panels. Leave empty to use the header color scheme.",
    "menu_item": "The top-level menu item this image appears under, named as it is in the menu. Capitalisation does not matter. An image naming nothing is not shown.",
    "menu_style": "A mega menu turns a top-level link's children into columns. The drawer on small screens always uses dropdowns.",
    "menu_position": "Search, account, cart, and the selectors fill whichever slot the logo and navigation leave free.",
    "mobile_layout": "Below 750px wide. Left off, the section keeps the spacing set above.",
    "mobile_page_spacing": "Below 750px wide. Left off, phones use the page margin and section spacing set above. Page width needs no mobile setting, because a phone is always narrower.",
    "mobile_type": "Everything above applies from 750px wide up. The settings below replace it on narrower screens. Size is always set here, because a heading sized for a wide screen rarely fits a phone. Line height, letter spacing, and case follow the desktop setting until you change them. Font family is shared, so a heading keeps its typeface everywhere.",
    "offer_text": "Only describe a discount you have set up as an automatic discount in Shopify admin. The theme shows this text; it does not change any price.",
    "page_background_media": "An image here backs the whole section. For a photo behind the header only, leave the page content empty and build the body from sections below.",
    "page_height": "Gives the header room to sit in when it has a background image.",
    "password_title_preset": "Styles the store name. With a logo uploaded in Theme settings, the logo is shown instead.",
    "pagination_type": "Load more and infinite scroll add the next page below the current one. Infinite scroll loads it as the visitor nears the end, and keeps the button for anyone who can't scroll to it.",
    "pause_on_hover": "Stops on the current slide while the pointer is over the slideshow. Keyboard focus and the pause button still stop it when this is off.",
    "policy": "Write the text in Settings > Policies in Shopify admin. A policy left empty there is not shown.",
    "policy_heading": "Leave empty to use the policy's own title.",
    "popup_code": "Create the discount in Shopify admin first. The theme only shows the code.",
    "popup_delay": "Added to the minutes. The wait is counted from the first page of the visit, so it carries on as the customer browses. Zero minutes and zero seconds shows it straight away.",
    "popup_image": "Sits beside or above the signup. Leave empty for a popup that is only words.",
    "popup_position": "Where the popup sits in the window.",
    "popup_products": "Shown under the signup. Leave empty for a popup that only asks for an email.",
    "popup_remember": "Days before a customer who closed it is asked again. Zero asks again on every page load, after the same wait or scroll. A customer who signed up is not asked again.",
    "popup_scroll_depth": "How far down a page the customer scrolls before it shows. Counted on each page, from the top. On a page too short to scroll, only a wait can show it.",
    "popup_trigger": "With a wait and scrolling, it shows at whichever comes first.",
    "popup_width": "Raise it when the popup carries a picture beside the signup.",
    "question_preset": "Default keeps the Heading 5 look. Only the text style changes; the question stays the button that opens its answer.",
    "quick_add": "Adds single-variant products straight to the cart. Products with options link to the product page instead.",
    "random_products": "Shows a different selection from the collection on every page load, instead of its first products. Only the first 50 products of a collection are included. Reload the theme editor to draw a new selection.",
    "require_phone": "A required phone number stops some people finishing the form. Turn it off to ask without insisting.",
    "scrollbar_color": "Applies to the scrollbar on every page. Browsers that cannot color scrollbars show their own.",
    "scrolled_colors": "Used once the page has scrolled. Leave both empty to keep the color scheme. Check that the two read against each other.",
    "search_filters": "Shopify offers filters for a search narrowed to products, so the drawer appears on the Products tab.",
    "search_popular_menu": "Shown in the search panel before anything is typed.",
    "secondary_image": "Sits beside the text, on the side away from the main image. Stacks below the text on mobile.",
    "show_card_button": "With a button, the title and the button link to the collection instead of the whole card.",
    "show_cart_terms": "Checkout stays disabled until the box is ticked.",
    "show_discount_field": "Codes are applied at checkout, which is the only place Shopify accepts them.",
    "show_dynamic_checkout": "Shop Pay and other accelerated buttons. Their branded colors cannot be changed.",
    "show_featured_post": "Shown on the first page only, and left out of the grid below so it does not appear twice.",
    "show_follow_on_shop": "Lets customers follow your store in the Shop app. Appears once Shop Pay is turned on and the Shop channel is installed.",
    "show_instagram_icon": "Needs a profile link. Sits over the center of the row.",
    "show_filters": "Filters are set up in your store's search and discovery settings. When none are set up, the button is hidden.",
    "device_vendor_value": "Must match the product vendor. For example, use iPhones when that is the vendor name.",
    "filter_layout": "Left of the products on a wide screen. On a phone, filters still open as a drawer.",
    "show_sidebar_search": "Shows product suggestions while typing. Submitting opens the store-wide product search. Choose Left of products in Filter layout to show the field.",
    "show_sidebar_menu": "Choose a menu below. Choose Left of products in Filter layout to show it.",
    "show_read_more": "When hidden, the whole card links to the post instead.",
    "show_shipping_estimate": "Rates come from your own shipping settings at checkout.",
    "show_view_toggle": "Lets the customer switch between the column count set below and half of it.",
    "slide_mobile_alignment": "Below 990px wide, where the image stacks above the content. The settings above apply on wider screens.",
    "slider_autoplay": "Moves to the next slides on its own and starts over after the last. Pauses on hover and focus, and shows a pause button. Never starts for visitors who have reduced motion turned on.",
    "slider_loop": "The next arrow returns to the first item after the last one, and the previous arrow jumps to the last.",
    "slideshow_autoplay": "Moves to the next slide on its own and starts over after the last. Shows a pause button. Pause on hover is the setting below. Never starts for visitors who have reduced motion turned on.",
    "slideshow_background": "The background stays in place while the slides move across it.",
    "social_links_source": "Links come from the Social media group in theme settings.",
    "social_media": "Each icon appears only when its link is filled in.",
    "stagger": "Lifts every second image so the row reads as a composition.",
    "start_position": "How much of the frame the first image covers when the page loads.",
    "sticky_add_to_cart": "Shows while the Add to cart button on the page itself is out of view. Add it to the product template.",
    "sticky_product_details": "Holds the product details still beside the gallery. They scroll away once the gallery has passed. On a phone the details follow the gallery.",
    "tab_title": "Leave empty to use the collection name.",
    "tab_page": "Applies when the content source is Page. The page's content is shown, not its title.",
    "tab_subtitle_preset": "Headings inside a tab's content, such as a Materials heading in the description. Default keeps each heading's own style.",
    "tag": "Sets the heading level for search engines and screen readers. Use the preset to change how the text looks.",
    "text_color": "Leave empty to use the color scheme text color.",
    "text_position": "Where the text and the overlapping image sit down the section. They move together.",
    "text_presets_scale": "Sizes set the largest value. Text scales down automatically on smaller screens.",
    "transparent_color_scheme": "Used only while the header is transparent. Pick one that reads against your hero image.",
    "transparent_logo": "Shown while the header is transparent, and replaced by the main logo once the page scrolls. Leave empty to use the main logo throughout.",
    "transparent_on_home": "The header sits over the first section. A sticky or fixed header turns solid once the page scrolls; a static one scrolls away transparent.",
    "transparent_scrim": "A soft shade that keeps the links legible over a photo.",
    "use_collection_image": "Falls back to the background image below when the collection has no image.",
    "use_product_image": "Falls back to the background image below when the product has no image.",
    "variant_price_label": "A variant's custom.price_label metafield overrides the section's Free price label setting for that variant.",
    "use_slider": "Items scroll sideways instead of wrapping. The Columns settings set how many are visible.",
    "use_slider_mobile": "Items scroll sideways below 750px and stay a grid above it. Columns on mobile sets how many are visible.",
    "use_video_on_mobile": "Turning this off shows the cover image on small screens, which loads far less over a mobile connection.",
    "video_background": "Upload the video to your store, then choose it here. The video plays without sound, and a button to pause it sits in the corner of the section."
